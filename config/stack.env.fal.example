# ~/.claude/stack.env for the case where EVERY image operation runs on fal (https://fal.ai).
# Claude itself is not configured here: it runs on your Claude subscription (keep ANTHROPIC_API_KEY unset).
#
#   cp config/stack.env.fal.example ~/.claude/stack.env && chmod 600 ~/.claude/stack.env
#   then replace every `your-fal-key` with your key (https://fal.ai/dashboard/keys) and run: bin/stack keys
#
# The file is PARSED (KEY=VALUE lines only), never sourced, by bin/mcp-run and bin/mcp-headers, so there is
# no variable expansion: the router has no shared-key fallback and reads each operation's own
# IMAGE_<OP>_KEY, so the same fal key is repeated on every operation. Keep comments on their own lines.
#
# How the `image` MCP server uses fal: URL is always https://queue.fal.run (fal's queue API; the host selects
# the fal protocol), MODEL is the fal endpoint id exactly as on https://fal.ai/models/<endpoint-id>. Request
# fields are mapped from each endpoint's live OpenAPI schema, and an endpoint that lacks a required input
# (references, mask, transparent background) is refused with a clear error instead of silently degrading.
# A tool appears once its URL, KEY and MODEL are all set; restart or /mcp-reconnect after edits.
# The endpoints below were checked against fal's live catalog and OpenAPI schemas on 2026-11-08 (prices from the
# fal model pages that day); fal adds and retires endpoints often, so confirm on fal.ai/models if one starts failing.
# IMAGE_<OP>_PARAMS values are sent with every call; `model`, `prompt` and input images are router-owned and refused.

# --- web research / crawling (remote MCP servers via headersHelper; not fal) ------------------------------
EXA_API_KEY=
JINA_API_KEY=
SPIDER_API_KEY=
CONTEXT7_API_KEY=

# --- text-to-image -> image_generate --------------------------------------------------------------------
# OpenAI GPT Image 2.6 Sunburst (released 2026-11-04): #1 on Artificial Analysis text-to-image (1259 vs Nano
# Banana 2.1 1176) and ahead of Nano Banana 2.1 on LMArena. Token-priced: about $0.04-0.05 per image at high,
# about $0.21 at max; quality auto | low | medium | high | xhigh | max. Total pixels 655,360-8,294,400.
# alternatives: google/nano-banana-2.1 '{"resolution":"2K"}' ($0.059, seed and 4K), openai/gpt-image-2.6/flare/text-to-image
# (faster), openai/gpt-image-2.5/sunburst/text-to-image, ideogram/v4.5 (typography), fal-ai/flux-2-max
IMAGE_GEN_URL=https://queue.fal.run
IMAGE_GEN_KEY=your-fal-key
IMAGE_GEN_MODEL=openai/gpt-image-2.6/sunburst/text-to-image
IMAGE_GEN_PARAMS='{"quality":"high"}'

# --- generation with reference images (consistent character, product or style) -> image_generate_with_references
# GPT Image 2.6 Sunburst edit: up to 16 image_urls; #1 on Artificial Analysis image editing (1209 vs 1152).
# LMArena's multi-image board has not rated 2.6 yet (2.5 Sunburst leads it), so re-check in a couple of weeks.
# Input images add $8 per 1M image tokens.
# alternatives: openai/gpt-image-2.5/sunburst/edit, google/nano-banana-2.1/edit '{"resolution":"2K"}' ($0.063),
# fal-ai/flux-2-max/edit, bytedance/seedream/v5/pro/edit
IMAGE_REF_URL=https://queue.fal.run
IMAGE_REF_KEY=your-fal-key
IMAGE_REF_MODEL=openai/gpt-image-2.6/sunburst/edit
IMAGE_REF_PARAMS='{"quality":"high"}'

# --- instruction edits / masked inpainting -> image_edit ------------------------------------------------
# GPT Image 2.6 Sunburst edit: optional mask_url (white = edit, the router's default convention; the router
# composites the result so pixels outside the mask stay untouched). Ahead of Ideogram 4.5 Edit by ~130-140 Elo
# on both arenas.
# alternative for unmasked edits that must stay pixel-exact: ideogram/v4.5/edit with
# '{"quality":"medium","edit_precision":"high","mask_convention":"black-edit"}' (Ideogram masks are black = edit;
# without mask_convention masked edits come out inverted)
IMAGE_EDIT_URL=https://queue.fal.run
IMAGE_EDIT_KEY=your-fal-key
IMAGE_EDIT_MODEL=openai/gpt-image-2.6/sunburst/edit
IMAGE_EDIT_PARAMS='{"quality":"high","reasoning_effort":"low"}'

# --- transparent (RGBA) generation -> image_generate_transparent ----------------------------------------
# needs a `background` input that accepts "transparent" (the router asks for PNG output); GPT Image 2.6 Sunburst
# (background auto | transparent | opaque), same token rates as 2.5 and faster. fal-ai/ideogram/v3/generate-transparent
# has no `background` input, so the router refuses it.
# alternatives: openai/gpt-image-2.6/flare/text-to-image (faster, cheaper), openai/gpt-image-2.5/sunburst/text-to-image
IMAGE_TRANSPARENT_URL=https://queue.fal.run
IMAGE_TRANSPARENT_KEY=your-fal-key
IMAGE_TRANSPARENT_MODEL=openai/gpt-image-2.6/sunburst/text-to-image
IMAGE_TRANSPARENT_PARAMS='{"quality":"xhigh"}'

# --- segmentation: prompt -> mask PNG -> image_segment ----------------------------------------------------
# SAM 3.1, $0.01 per request; alternative: fal-ai/sam-3/image ($0.005)
IMAGE_SEGMENT_URL=https://queue.fal.run
IMAGE_SEGMENT_KEY=your-fal-key
IMAGE_SEGMENT_MODEL=fal-ai/sam-3-1/image

# --- background removal -> RGBA cutout -> image_remove_background ---------------------------------------
# Bria RMBG 2.0 (licensed training data), $0.018 per image; the router keeps the original pixels and takes
# only the model's alpha. alternatives: pixelcut/background-removal ($0.022), fal-ai/birefnet/v2 (open)
IMAGE_BG_REMOVAL_URL=https://queue.fal.run
IMAGE_BG_REMOVAL_KEY=your-fal-key
IMAGE_BG_REMOVAL_MODEL=fal-ai/bria/background/remove

# --- upscaling -> image_upscale ----------------------------------------------------------------------------
# Topaz Gigapixel precision (default model Standard V2; `model` is router-owned, so it cannot be set here),
# $0.08 per started 24 MP of output; upscale_factor 1..4. A transparent source keeps its alpha (the router
# reattaches it). alternatives: topaz/upscale/image/generative (Wonder 3.5), fal-ai/recraft/upscale/crisp (graphics)
IMAGE_UPSCALE_URL=https://queue.fal.run
IMAGE_UPSCALE_KEY=your-fal-key
IMAGE_UPSCALE_MODEL=topaz/upscale/image/precision
IMAGE_UPSCALE_PARAMS='{"upscale_factor":2.5}'

# --- vector generation -> vector_generate -------------------------------------------------------------------
# Ideogram has no SVG endpoint on fal, so the router's `layerize` strategy runs a pipeline: Ideogram 4.5 draws
# (quality medium, $0.06), fal-ai/ideogram/v3/layerize-text ($0.09, still current) separates the lettering, IMAGE_TRACE vectorizes the
# text-free artwork ($0.01) and the lettering comes back as live <text> in a `Text` layer over the `Artwork`
# layer(s): editable by Claude as SVG text and exported as text by export_pdf (layered PDF).
# strategy `trace` skips the text step (one traced Artwork layer).
# native-SVG alternatives (no pipeline, no strategy): ideogram/vector/text-to-vector (Ideogram Vector 1.0,
# 2026-10-22; '{"quality":"medium"}' $0.16 per SVG; live <text> not yet verified, so it is not the default),
# fal-ai/recraft/v4.1/pro/text-to-vector ($0.30, palette control), fal-ai/recraft/v4.1/text-to-vector ($0.08, icons)
IMAGE_VECTOR_URL=https://queue.fal.run
IMAGE_VECTOR_KEY=your-fal-key
IMAGE_VECTOR_MODEL=ideogram/v4.5
IMAGE_VECTOR_PARAMS='{"strategy":"layerize","quality":"medium"}'

# --- raster -> vector tracing -> image_vectorize (also the tracer of the VECTOR pipeline) ------------------
# Recraft vectorize (AI redraw into clean SVG), $0.01 per image (PNG/JPG/WEBP, 256-4096 px, under 5 MB).
# newer alternative: ideogram/vector/image-to-vector ($0.10, inputs up to 50 MB) returns `images`, not `image`,
# so it needs a router change before it can be used here.
# offline alternative without fal: set IMAGE_TRACE_API=local (vtracer, free, follows the pixels exactly)
# and leave URL/KEY/MODEL empty (fal-ai/image2svg is the same vtracer, hosted)
IMAGE_TRACE_URL=https://queue.fal.run
IMAGE_TRACE_KEY=your-fal-key
IMAGE_TRACE_MODEL=fal-ai/recraft/vectorize

# --- SVG manipulation -------------------------------------------------------------------------------------
# fal hosts image models, not the chat model svg_transform needs, so agents edit SVG text themselves
IMAGE_VECTOR_MANIPULATION_MODEL=claude

# --- fal's own hosted MCP server (optional; ~60 tools: model search, run_model, jobs) --------------------
# only used after `bin/stack mcp enable fal`; the image server above does not need it
FAL_KEY=
